# ---
# --- Base executables
# ---

# Local executable scripts
export PATH="$HOME/.shell/exec:$PATH"

# ---
# --- AI tooling
# ---

# Oh My Pi: default profile for this machine, so a bare `omp` picks up the
# right identity without a separate "default" profile in ~/.omp/agent.
{{- $ompProfile := "personal" }}
{{- if eq .hostname "paul-enapi" }}
{{-   $ompProfile = "enapi" }}
{{- end }}
export OMP_PROFILE="{{ $ompProfile }}"
