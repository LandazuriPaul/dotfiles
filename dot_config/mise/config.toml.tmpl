[settings]
# Config files with these prefixes will be trusted by default
trusted_config_paths = [
    '~/dev',
]
{{ if eq .chezmoi.os "darwin" -}}
# Docker Desktop is the container runtime; skip the Colima/Lima pins that project configs might declare
disable_tools = ["aqua:abiosoft/colima", "aqua:lima-vm/lima"]
{{- end }}

[tools]
# Basic tools
bat = "latest"
chezmoi = "latest"
fd = "latest"
fzf = "latest"
hwatch = "latest"
jq = "latest"
neovim = "latest"
rg = "latest"
tmux = "latest"
yq = "latest"
zoxide = "latest"

# Password Managers
1password-cli = "latest"

# Kubernetes: k9s also on raichu, to inspect its own cluster (its kubeconfig
# is already there, and k9s runs as your user, like kubectl)
k9s = "latest"

{{ if ne .hostname "raichu" -}}
# Everything below stays off raichu: it faces the internet, so it only gets
# the basics above (1password-cli loads its SSH key, k9s views its cluster).

# Kubernetes
kubectl = "latest"
kubeswitch = "latest"
stern = "latest"

# GitHub
act = "latest"
gh = "latest"

# AI tools
claude = "latest"
"github:can1357/oh-my-pi" = "latest"

# Runtimes
bun = "latest"
python = "3"
{{- end }}
